# ==============================================================================
# SIH-190 ROOT ENVIRONMENT TEMPLATE (Development Defaults)
# NOTE: Never commit real credentials or actual .env files to source control!
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_DEBUG=true

# Database (PostgreSQL 16 + pgvector)
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_DB=sih190
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Object Storage (MinIO / S3)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=replace_with_secure_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=replace_with_secure_minio_password
S3_BUCKET_DOCUMENTS=sih190-documents
S3_BUCKET_EVIDENCE=sih190-evidence
S3_REGION=us-east-1

# JWT & Cryptography (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace_with_64_char_hex_secret_key_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gemini AI (For future AI phase - placeholder)
GEMINI_API_KEY=

# Backend & Frontend Endpoints
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
