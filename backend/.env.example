# ==============================================================================
# FASTAPI BACKEND CONFIGURATION
# ==============================================================================
APP_NAME="Secure Digital Evidence Management Platform"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Database
POSTGRES_USER=sih_user
POSTGRES_PASSWORD=replace_with_secure_password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sih190

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_secure_redis_password
REDIS_DB=0

# Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=replace_with_secure_minio_password
S3_BUCKET_DOCUMENTS=sih190-documents
S3_BUCKET_EVIDENCE=sih190-evidence
S3_REGION=us-east-1
S3_USE_SSL=false

# Security
JWT_SECRET_KEY=replace_with_64_char_hex_secret_key_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging & Rate Limiting
LOG_LEVEL=INFO
RATE_LIMIT_DEFAULT="100/minute"
